{
  "name": "mossmere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original cosy village social-deduction game for trusted friends.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "assets": "node scripts/generate-assets.mjs",
    "test": "node --test tests/*.test.js",
    "test:milestone1": "node --test tests/movement.test.js tests/jobs.test.js tests/profile.test.js",
    "test:milestone2": "node --test tests/network.test.js tests/privacy.test.js",
    "test:milestone3": "node --test tests/match.test.js",
    "test:milestone4": "node --test tests/assets.test.js",
    "build": "npm run assets && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": { "three": "0.186.1", "peerjs": "1.5.5" },
  "devDependencies": { "vite": "8.0.13" }
}
